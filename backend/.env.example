# Copy to backend/.env for local development. Never commit backend/.env.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only legacy service-role key for username registration and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# BIND_ADDR=0.0.0.0:3000
# SUPABASE_JWT_AUDIENCE=authenticated
# RUST_LOG=supra_backend=info,tower_http=debug

# Server-only provider keys. Missing keys produce per-signal unavailable states.
OPENAQ_API_KEY=
OPEN_METEO_API_KEY=
TOMTOM_API_KEY=

# Google AI Studio Gemini API key for Agent 1 Conversational Assistant.
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=
# Choose one supported model for your Google project; no silent model fallback.
GEMINI_MODEL=gemini-3.5-flash-lite

# Runtime avatar storage; mount a durable volume in production.
AVATAR_STORAGE_DIR=uploads/avatars
# Explicit external origin, never derived from an untrusted Host header.
PUBLIC_BASE_URL=http://localhost:3000

# Commute features & Alerts configuration:
# Enable background scheduled alert evaluations (default false).
ALERTS_ENABLED=false
# Python/PyTorch + publisher RSS service (loopback by default).
INTELLIGENCE_URL=http://127.0.0.1:8001
# Optional operator-reviewed JSON incident feed override; empty uses ANTARA RSS.
NEWS_INCIDENTS_URL=
# Valhalla routing endpoint for walking and motorcycle modes.
VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
# Public transport defaults: supplied Transjakarta GTFS + Commute Data API.
COMMUTE_API_URL=https://api.commute.shiorilabs.id
# Optional absolute path; defaults to repository file_gtfs/ next to backend/.
# TRANSJAKARTA_GTFS_DIR=/absolute/path/to/file_gtfs
# Optional legacy OTP override (leave empty to use the two sources above).
OTP_GRAPHQL_URL=
# Dedicated isolated test database (must end in _test) for cargo test -- --ignored.
SUPRA_TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/supra_foundation_test
