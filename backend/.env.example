# Copy to backend/.env for local development. Never commit backend/.env.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# RUST_LOG=supra_backend=info,tower_http=debug

# Server-only provider keys. Missing keys produce per-signal unavailable states.
OPENAQ_API_KEY=
TOMTOM_API_KEY=

# Google AI Studio Gemini API key for Agent 1 Conversational Assistant.
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=
# Choose one supported model for your Google project; no silent model fallback.
GEMINI_MODEL=gemini-2.5-flash

# Runtime avatar storage; mount a durable volume in production.
AVATAR_STORAGE_DIR=uploads/avatars
# Explicit external origin, never derived from an untrusted Host header.
PUBLIC_BASE_URL=http://localhost:3000

# Commute features & Alerts configuration:
# Enable background scheduled alert evaluations (default false).
ALERTS_ENABLED=false
# Optional operator-reviewed JSON incident feed for verified events near Jakarta.
NEWS_INCIDENTS_URL=
# Valhalla routing endpoint for walking and motorcycle modes.
VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
# OpenTripPlanner 2.x GTFS GraphQL endpoint with Jakarta transit data.
OTP_GRAPHQL_URL=
# Dedicated isolated test database (must end in _test) for cargo test -- --ignored.
SUPRA_TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/supra_foundation_test
